# Cloudflare R2 Configuration
# Copy this to .env.local and fill in your values

CLOUDFLARE_ACCOUNT_ID=your-account-id-here
CLOUDFLARE_R2_TOKEN=your-r2-api-token-here
CLOUDFLARE_BUCKET=lucen-media

# Optional: Custom domain for R2
# VITE_CDN_BASE_URL=https://lucen-media.r2.cloudflarecustomdomain.com
# VITE_CDN_BASE_URL=https://media.yourdomain.com
